rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function listOrEmpty(data, field) {
      return field in data ? data[field] : [];
    }

    // True if newList differs from oldList by exactly one toggle of request.auth.uid.
    function toggledSelfOnly(oldList, newList) {
      return (newList.size() == oldList.size() + 1
              && newList.hasAll(oldList)
              && newList.hasAny([request.auth.uid])
              && !oldList.hasAny([request.auth.uid]))
          || (newList.size() == oldList.size() - 1
              && oldList.hasAll(newList)
              && oldList.hasAny([request.auth.uid])
              && !newList.hasAny([request.auth.uid]));
    }

    match /users/{userId} {
      // El dueño siempre puede leer su propio perfil. Cualquier otro usuario
      // logueado puede leerlo salvo que sea privado, en cuyo caso solo pueden
      // sus propios seguidores (mismo criterio que las listas privadas).
      allow read: if isOwner(userId)
        || (isSignedIn()
            && (!('isPrivate' in resource.data) || resource.data.isPrivate != true
                || request.auth.uid in listOrEmpty(resource.data, 'followers')));

      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && !('password' in request.resource.data);

      // Owner can edit their own profile. Never allowed to newly introduce a password
      // field — but don't permanently lock out accounts that already have a legacy one
      // sitting in their doc from an old version of signUp(); just forbid adding one.
      allow update: if isOwner(userId)
        && (!('password' in request.resource.data) || 'password' in resource.data);

      // Any other signed-in user may only toggle themselves in/out of `followers`.
      // Self-follow is only allowed on public profiles; unfollow (removing self)
      // is always allowed, even from a private profile.
      allow update: if isSignedIn()
        && !isOwner(userId)
        && onlyChangedFields(['followers'])
        && toggledSelfOnly(listOrEmpty(resource.data, 'followers'), listOrEmpty(request.resource.data, 'followers'))
        && (!('isPrivate' in resource.data) || resource.data.isPrivate != true
            || !listOrEmpty(request.resource.data, 'followers').hasAny([request.auth.uid]));

      // A signed-in non-owner may send/cancel a follow request by toggling their
      // own uid in `followRequests`. Accept/decline is done by the owner below.
      allow update: if isSignedIn()
        && !isOwner(userId)
        && onlyChangedFields(['followRequests'])
        && toggledSelfOnly(listOrEmpty(resource.data, 'followRequests'), listOrEmpty(request.resource.data, 'followRequests'));

      // A signed-in non-owner may toggle their own uid in `following`. Used when a
      // private account accepts a follow request and mirrors itself onto the requester.
      allow update: if isSignedIn()
        && !isOwner(userId)
        && onlyChangedFields(['following'])
        && toggledSelfOnly(listOrEmpty(resource.data, 'following'), listOrEmpty(request.resource.data, 'following'));

      allow delete: if isOwner(userId);
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Owner can fully edit/delete their own review.
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Any other signed-in user may only toggle their own uid in `likes`.
      allow update: if isSignedIn()
        && resource.data.userId != request.auth.uid
        && onlyChangedFields(['likes'])
        && toggledSelfOnly(listOrEmpty(resource.data, 'likes'), listOrEmpty(request.resource.data, 'likes'));

      // Any other signed-in user may append exactly one comment authored as themselves.
      allow update: if isSignedIn()
        && resource.data.userId != request.auth.uid
        && onlyChangedFields(['comments'])
        && request.resource.data.comments.size() == listOrEmpty(resource.data, 'comments').size() + 1
        && request.resource.data.comments[request.resource.data.comments.size() - 1].userId == request.auth.uid;
    }

    match /lists/{listId} {
      // Owner can always read their own list; everyone else only if it's not private.
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || resource.data.privacy != 'private');

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.privacy in ['public', 'private'];

      // Owner can fully edit/delete their own list.
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Any other signed-in user may only toggle their own uid in `likes`, and only on public lists.
      allow update: if isSignedIn()
        && resource.data.userId != request.auth.uid
        && resource.data.privacy != 'private'
        && onlyChangedFields(['likes'])
        && toggledSelfOnly(listOrEmpty(resource.data, 'likes'), listOrEmpty(request.resource.data, 'likes'));
    }
  }
}
